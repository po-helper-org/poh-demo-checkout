# Проверка каждого PR и каждого коммита в main.
#
# Зависимостей у сервиса нет намеренно — это его свойство, а не упущение, и
# `npm ci` здесь молча создал бы их появлению повод.
name: CI

on:
  pull_request:
  push:
    branches: [main]

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read

jobs:
  tests:
    name: тесты
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - run: node --test "tests/*.test.mjs"
</file>

<file path=".github/workflows/openhands-resolver.yml">
# Активность Develop контура: подготовленный Issue → ветка → код → PR.
#
# Issue-Agent доводит задачу до `ready-for-dev` и системных требований, после чего
# диспатчит этот workflow (`shared/develop.py` в poh-issue-agents). Код пишет
# OpenHands в headless-режиме — прямо на раннере, без Docker-песочницы: раннер
# одноразовый и сам является песочницей, а поднимать внутри него ещё одну значит
# платить минутами за изоляцию, которая уже есть.
#
# Почему `workflow_dispatch`, а не метка-триггер. Метка — состояние, а не событие:
# повторная постановка уже висящей метки не шлёт ничего, и запуск теряется молча.
# Второй вход по метке `fix-me` оставлен как ручной дублёр для человека — им
# запускают прогон без Temporal, когда цикл почему-то не поднялся.
#
# Токен по умолчанию — штатный GITHUB_TOKEN раннера: PR-Agent здесь работает как
# GitHub App по вебхуку, а вебхуки App приходят независимо от того, кто автор PR.
# Секрет `PAT_TOKEN` перебивает его и нужен ровно в одном случае: если ревью
# переведут обратно на GitHub Actions. PR, созданный GITHUB_TOKEN, НЕ порождает
# событий workflow, и Actions-ревью на нём не запустилось бы.
name: OpenHands Resolver

on:
  workflow_dispatch:
    inputs:
      issue_number:
        description: Issue, который берём в разработку
        required: true
      research_branch:
        description: Ветка с артефактами аналитики (пусто — аналитики не было)
        required: false
        default: ''
      priority:
        description: Приоритет задачи по формуле Issue-Agent
        required: false
        default: ''
  issues:
    types: [labeled]

# Права выданы job'ам явно и минимально: ветка и коммит (contents), SubIssue по
# найденным edge-кейсам (issues), сам PR (pull-requests).
permissions:
  contents: write
  issues: write
  pull-requests: write

jobs:
  # Рубильник человека — отдельным job, а не первым шагом разработки. Причина не
  # косметическая: упавший шаг внутри `develop` сделал бы весь прогон `failure`,
  # и финальный доклад (`if: always()`) сообщил бы циклу «разработка сорвалась».
  # Но `agents:off` — это не сбой, а решение человека забрать задачу себе, и
  # докладывать о нём как о провале значит врать циклу. Отдельный job даёт
  # третий исход: `develop` не запускается вовсе и не докладывает ничего.
  gate:
    name: проверка рубильника
    runs-on: ubuntu-latest
    # Ручной вход отрабатывает только по своей метке. Без этого условия job
    # запускался бы на КАЖДОЙ метке, которую вешает триаж Issue-Agent, — то есть
    # несколько раз подряд на каждой новой задаче.
    if: >-
      github.event_name == 'workflow_dispatch' ||
      github.event.label.name == 'fix-me'
    outputs:
      go: ${{ steps.check.outputs.go }}
    steps:
      - id: check
        # Правило R4 протокола агентов: проверка раньше первого обращения к LLM.
        # Смысл в том, чтобы не тратить бюджет на то, что человек уже забрал себе.
        env:
          GH_TOKEN: ${{ secrets.PAT_TOKEN || github.token }}
          ISSUE_NUMBER: ${{ github.event.inputs.issue_number || github.event.issue.number }}
        run: |
          set -euo pipefail
          labels=$(gh issue view "$ISSUE_NUMBER" --repo "$GITHUB_REPOSITORY" \
                     --json labels --jq '.labels[].name')
          if grep -qix 'agents:off' <<<"$labels"; then
            echo "::notice::agents:off на #$ISSUE_NUMBER — прогон не начинается"
            echo "go=false" >> "$GITHUB_OUTPUT"
          else
            echo "go=true" >> "$GITHUB_OUTPUT"
          fi

  develop:
    name: разработка по Issue
    runs-on: ubuntu-latest
    needs: gate
    if: needs.gate.outputs.go == 'true'
    timeout-minutes: 45
    # Ограничение на УРОВНЕ JOB, а не workflow. На уровне workflow оно убивало
    # собственный прогон: каждая метка, которую вешает Issue-Agent, порождает
    # событие `issues.labeled`, такой прогон попадает в ту же группу и, хотя все
    # его job'ы пропускаются, всё равно вытесняет идущую разработку. Job в группу
    # не входит, пока не запустился, поэтому пропущенные прогоны безвредны.
    #
    # Сама группа нужна: две ветки от одного Issue дают два PR с одним
    # `Closes #N`, и корреляция события с задачей становится неоднозначной —
    # ровно тот случай, который Issue-Agent отказывается разрешать догадкой.
    concurrency:
      group: openhands-${{ github.event.inputs.issue_number || github.event.issue.number }}
      cancel-in-progress: true
    outputs:
      pr_number: ${{ steps.pr.outputs.number }}

    env:
      ISSUE_NUMBER: ${{ github.event.inputs.issue_number || github.event.issue.number }}
      RESEARCH_BRANCH: ${{ github.event.inputs.research_branch }}
      PRIORITY: ${{ github.event.inputs.priority }}
      # Токен виден и агенту: SubIssue по найденным edge-кейсам он заводит сам,
      # своим `gh issue create` изнутри прогона.
      GH_TOKEN: ${{ secrets.PAT_TOKEN || github.token }}
      GITHUB_TOKEN: ${{ secrets.PAT_TOKEN || github.token }}

    steps:
      - uses: actions/checkout@v4
        with:
          # Полная история: ветку работы заводим от main, а diff считаем от него же.
          fetch-depth: 0
          token: ${{ secrets.PAT_TOKEN || github.token }}

      - uses: actions/setup-node@v4
        with:
          node-version: '22'

      # Версия точная, не плавающая: у setup-uv нет тегов-мажоров выше v8 —
      # `@v10` не резолвится вовсе, и прогон падает на подготовке job'а.
      - uses: astral-sh/setup-uv@v10.0.1

      - name: Установить OpenHands
        run: uv tool install openhands --python 3.12

      - name: Собрать постановку для агента
        # Постановка собирается ЗДЕСЬ, а не в промпте агента: то, что уехало в
        # работу, должно быть видно в логе прогона дословно. Иначе на разборе
        # «почему агент сделал не то» нечего предъявить.
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/oh"
          task="$RUNNER_TEMP/oh/task.md"

          {
            echo "# Задача: реализовать Issue #$ISSUE_NUMBER"
            echo
            gh issue view "$ISSUE_NUMBER" --repo "$GITHUB_REPOSITORY" \
              --json title,body --template '## {{.title}}{{"\n\n"}}{{.body}}'
            echo
          } > "$task"

          if [ -n "$RESEARCH_BRANCH" ] && git ls-remote --exit-code --heads origin "$RESEARCH_BRANCH" >/dev/null 2>&1; then
            echo "## Системные требования (аналитика Issue-Agent)" >> "$task"
            echo >> "$task"
            git fetch --depth 1 origin "$RESEARCH_BRANCH"
            # Каталог фиксирован сервисом аналитики (`FNR_DIR` в poh-issue-agents),
            # ветка своя на каждый Issue. Порядок задан явно — требования первыми:
            # то, что агент прочитает раньше, весит больше, а `task.md` и
            # `concept.md` это путь к требованиям, а не сами требования.
            # Отсутствующий файл — не сбой: набор артефактов у прогонов разный.
            for f in system_requirements.md task.md concept.md; do
              path="sa_documentation/FNR/FNR_1/$f"
              if git cat-file -e "FETCH_HEAD:$path" 2>/dev/null; then
                echo "### $f" >> "$task"
                git show "FETCH_HEAD:$path" >> "$task"
                echo >> "$task"
              fi
            done
          else
            echo "## Аналитики по задаче нет — работай от тела Issue." >> "$task"
            echo >> "$task"
          fi

          # Правила работы лежат файлом в репозитории, а не строкой внутри
          # workflow: их правит тот, кто правит конвенции проекта, и держать их
          # в YAML значило бы прятать контракт от того, кому он адресован.
          cat .openhands/task-rules.md >> "$task"

          echo "::group::постановка, ушедшая агенту"
          cat "$task"
          echo "::endgroup::"

      - name: Ветка работы
        run: |
          set -euo pipefail
          git config user.name  "openhands-agent"
          git config user.email "openhands-agent@users.noreply.github.com"
          echo "WORK_BRANCH=feature/${ISSUE_NUMBER}-openhands" >> "$GITHUB_ENV"
          git checkout -b "feature/${ISSUE_NUMBER}-openhands"

      - name: Прогон OpenHands
        env:
          LLM_API_KEY: ${{ secrets.LLM_API_KEY }}
          LLM_MODEL: ${{ vars.LLM_MODEL || 'openai/glm-4.6' }}
          LLM_BASE_URL: ${{ vars.LLM_BASE_URL || 'https://api.z.ai/api/coding/paas/v4' }}
          OPENHANDS_SUPPRESS_BANNER: '1'
        run: |
          set -euo pipefail
          openhands --headless --override-with-envs -f "$RUNNER_TEMP/oh/task.md"

      - name: Проверки
        # Тот же прогон, что и в CI. Гоняется ЗДЕСЬ, а не только на PR: PR,
        # созданный GITHUB_TOKEN, не порождает событий workflow, поэтому CI на
        # нём не запускается вовсе. Без этого шага красный код уезжал бы в PR
        # без единого признака того, что он красный.
        #
        # Падение здесь останавливает прогон до пуша: ветки и PR не будет, а
        # цикл получит доклад о провале и вернёт задачу человеку.
        run: node --test "tests/*.test.mjs"

      - name: Коммит и пуш
        id: push
        run: |
          set -euo pipefail
          git add -A
          if git diff --cached --quiet; then
            echo "changed=false" >> "$GITHUB_OUTPUT"
            echo "::warning::агент не изменил ни одного файла"
            exit 0
          fi
          git commit \
            -m "feat(#${ISSUE_NUMBER}): реализация по системным требованиям" \
            -m "Автор изменений — OpenHands, запущен активностью Develop по Issue #${ISSUE_NUMBER}."
          git push -u origin "$WORK_BRANCH"
          echo "changed=true" >> "$GITHUB_OUTPUT"

      - name: Открыть PR
        id: pr
        if: steps.push.outputs.changed == 'true'
        run: |
          set -euo pipefail
          # `Closes #N` — сквозной ключ цепочки: по нему Issue-Agent связывает PR
          # с задачей, а GitHub закрывает её при слиянии.
          body="$RUNNER_TEMP/oh/pr-body.md"
          {
            printf 'Closes #%s\n\n' "$ISSUE_NUMBER"
            printf 'Разработку вёл OpenHands по системным требованиям из `%s`.\n' "${RESEARCH_BRANCH:-—}"
            printf 'Найденные по дороге edge-кейсы вынесены отдельными SubIssue и в этой ветке не чинились.\n\n'
            printf '<sub>origin: agent · root-issue: #%s</sub>\n' "$ISSUE_NUMBER"
          } > "$body"

          title=$(gh issue view "$ISSUE_NUMBER" --repo "$GITHUB_REPOSITORY" --json title --jq .title)
          url=$(gh pr create \
            --repo "$GITHUB_REPOSITORY" \
            --base main \
            --head "$WORK_BRANCH" \
            --title "feat(#${ISSUE_NUMBER}): ${title}" \
            --body-file "$body")
          echo "url=$url" >> "$GITHUB_OUTPUT"
          echo "number=$(gh pr view "$url" --json number --jq .number)" >> "$GITHUB_OUTPUT"

      - name: Доложить в цикл Issue
        # Событие уходит ВСЕГДА (`if: always()`): цикл ждёт в фазе
        # `in-development`, и молчание провалившегося прогона оставило бы Issue
        # там навсегда. Нечем доложить — тоже факт, и он должен дойти.
        if: always()
        env:
          ISSUE_AGENT_URL: ${{ secrets.ISSUE_AGENT_URL }}
          AGENT_EVENT_SECRET: ${{ secrets.AGENT_EVENT_SECRET }}
          PR_URL: ${{ steps.pr.outputs.url }}
          PR_NUMBER: ${{ steps.pr.outputs.number }}
          JOB_STATUS: ${{ job.status }}
        run: |
          set -euo pipefail
          if [ -z "${ISSUE_AGENT_URL:-}" ] || [ -z "${AGENT_EVENT_SECRET:-}" ]; then
            echo "::warning::ISSUE_AGENT_URL/AGENT_EVENT_SECRET не заданы — событие не отправлено"
            exit 0
          fi

          if [ "$JOB_STATUS" = "success" ] && [ -n "${PR_NUMBER:-}" ]; then
            status=started; phase=pr-open
            detail="OpenHands открыл PR ${PR_URL} — Closes #${ISSUE_NUMBER}"
            ref="$PR_NUMBER"
          else
            status=failed; phase=in-development
            detail="Прогон OpenHands завершился как ${JOB_STATUS}, PR не открыт: ${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}"
            ref="run-${GITHUB_RUN_ID}"
          fi

          payload=$(jq -nc \
            --arg repo "$GITHUB_REPOSITORY" --arg phase "$phase" --arg status "$status" \
            --arg ref "$ref" --arg detail "$detail" --argjson root "$ISSUE_NUMBER" \
            '{repo:$repo, agent:"openhands", phase:$phase, status:$status,
              ref:$ref, root_issue:$root, detail:$detail}')

          sig="sha256=$(printf '%s' "$payload" \
            | openssl dgst -sha256 -hmac "$AGENT_EVENT_SECRET" -r | cut -d' ' -f1)"

          curl -sS --fail-with-body -X POST "${ISSUE_AGENT_URL%/}/agent-event" \
            -H 'Content-Type: application/json' \
            -H "X-Agent-Signature-256: $sig" \
            -d "$payload"

  # Ревью вызовом, а не отдельным триггером: PR, созданный GITHUB_TOKEN, не
  # порождает событий workflow, и ревью по `pull_request` на нём не запустилось
  # бы никогда. Вызванный workflow идёт частью этого же прогона.
  review:
    name: ревью открытого PR
    needs: develop
    if: needs.develop.outputs.pr_number != ''
    uses: ./.github/workflows/pr-review.yml
    with:
      pr_number: ${{ needs.develop.outputs.pr_number }}
      root_issue: ${{ github.event.inputs.issue_number || github.event.issue.number }}
    secrets: inherit
</file>

<file path=".github/workflows/pr-review.yml">
# Ревью PR (PR-Agent на GLM) + доклад в цикл Issue.
#
# Два входа, один код ревью:
#
#   workflow_call   — вызов из прогона разработки сразу после открытия PR.
#                     Именно вызов, а не отдельный триггер: PR, созданный
#                     GITHUB_TOKEN, НЕ порождает событий workflow (правило
#                     GitHub против рекурсии), и ревью по событию `pull_request`
#                     на таком PR не запустилось бы никогда. Вызванный workflow
#                     идёт частью того же прогона и этого ограничения не знает.
#
#   issue_comment   — повторная проверка после правок: человек (или Claude Code)
#                     пишет `/review` в PR. Комментарий от живого пользователя
#                     события порождает, здесь ограничения нет.
#
# Ревью гоняется CLI-образом pr-agent, а не GitHub Action'ом: action читает
# событие прогона и на `workflow_call` не нашёл бы PR, о котором речь. CLI
# принимает адрес PR явным аргументом и одинаково работает с обоих входов.
name: PR Review

on:
  workflow_call:
    inputs:
      pr_number:
        required: true
        type: string
      root_issue:
        required: false
        type: string
        default: ''
  issue_comment:
    types: [created]

  #   pull_request    — PR открыл агент разработки, который живёт НЕ в Actions.
  #                     В режиме `local` контур пишет код и открывает PR внутри
  #                     стенда, своим GitHub App: `openhands-resolver.yml` не
  #                     запускается вовсе, а значит `workflow_call` некому
  #                     сделать. Ревью не начиналось никогда, цикл оставался в
  #                     фазе `pr-open` до истечения срока — и выглядело это как
  #                     зависший PR-Agent. Токен App не GITHUB_TOKEN, поэтому
  #                     правило GitHub против рекурсии здесь не действует и
  #                     событие приходит.
  pull_request:
    types: [opened]

permissions:
  contents: read
  pull-requests: write
  issues: write

jobs:
  review:
    name: ревью PR
    runs-on: ubuntu-latest
    # Вход различается по `inputs`, а НЕ по `github.event_name`: вызванный
    # workflow наследует контекст вызывающего, и `event_name` там показывает
    # исходное событие (`workflow_dispatch`), а не `workflow_call`. Условие на
    # `event_name` молча пропускало ревью после каждой разработки.
    #
    # Для комментария: только в PR и только команда `/review`. Фильтр по
    # `user.type != 'Bot'` снят: перепроверку после круга правок запрашивает сам
    # цикл, и пишет он токеном GitHub App — то есть ботом. С фильтром круг
    # правок вносил изменения и ждал ревью, которое не запускалось. Петли это не
    # создаёт: ни один ответ агентов не начинается с `/review`, а число кругов
    # ограничено PR_FIX_MAX_ROUNDS.
    if: >-
      inputs.pr_number != '' ||
      github.event_name == 'pull_request' ||
      (github.event.issue.pull_request != null &&
       startsWith(github.event.comment.body, '/review'))
    timeout-minutes: 20

    env:
      PR_NUMBER: ${{ inputs.pr_number || github.event.pull_request.number || github.event.issue.number }}
      GH_TOKEN: ${{ secrets.PAT_TOKEN || github.token }}

    steps:
      - name: Рубильник человека
        # Правило R4: проверка раньше первого обращения к LLM. `agents:off` на
        # PR либо на связанном Issue останавливает ревью до траты бюджета.
        id: gate
        run: |
          set -euo pipefail
          labels=$(gh pr view "$PR_NUMBER" --repo "$GITHUB_REPOSITORY" \
                     --json labels --jq '.labels[].name')
          if grep -qix 'agents:off' <<<"$labels"; then
            echo "::notice::agents:off на PR #$PR_NUMBER — ревью не запускается"
            echo "go=false" >> "$GITHUB_OUTPUT"
          else
            echo "go=true" >> "$GITHUB_OUTPUT"
          fi

      - name: Ревью
        id: review
        if: steps.gate.outputs.go == 'true'
        env:
          LLM_API_KEY: ${{ secrets.LLM_API_KEY }}
          LLM_MODEL: ${{ vars.PR_AGENT_MODEL || 'openai/glm-4.6' }}
          LLM_BASE_URL: ${{ vars.LLM_BASE_URL || 'https://api.z.ai/api/coding/paas/v4' }}
        run: |
          set -uo pipefail
          url="${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/pull/${PR_NUMBER}"

          # pr-agent ВЫХОДИТ НУЛЁМ, даже когда ревью не состоялось: на
          # rate-limit модели он пишет `Failed to review PR` в лог, оставляет в
          # PR заглушку «Preparing review...» и завершается успешно. Шаг Actions
          # отчитывался успехом, цикл получал `status=started`, и круг правок
          # уходил доводить PR по пустому тексту. Поэтому исход определяется по
          # выводу, а не по коду возврата.
          review() {
            # persistent_comment (дефолт) переписывает ОДИН верхний комментарий
            # «PR Reviewer Guide» вместо того, чтобы плодить новый на каждый круг.
            # Именно поэтому «замечаний нет» видно как исчезнувший пункт, а не как
            # отдельное сообщение.
            docker run --rm \
              -e "OPENAI.KEY=${LLM_API_KEY}" \
              -e "OPENAI.API_BASE=${LLM_BASE_URL}" \
              -e "CONFIG.MODEL=${LLM_MODEL}" \
              -e "CONFIG.FALLBACK_MODELS=[]" \
              -e "CONFIG.CUSTOM_MODEL_MAX_TOKENS=128000" \
              -e "CONFIG.GIT_PROVIDER=github" \
              -e "CONFIG.PUBLISH_OUTPUT=true" \
              -e "GITHUB.USER_TOKEN=${GH_TOKEN}" \
              -e "GITHUB.DEPLOYMENT_TYPE=user" \
              codiumai/pr-agent:latest --pr_url "$url" review 2>&1 | tee /tmp/review.log
            ! grep -q "Failed to review PR" /tmp/review.log
          }

          # Один повтор с паузой: rate-limit — состояние на минуту, а не отказ.
          # Больше одного не нужно: если ключ выбран надолго, PR подождёт
          # человека, а не будет жечь минуты раннера.
          review && exit 0
          echo "::warning::ревью не удалось с первого раза — повтор через 90 с"
          sleep 90
          review

      - name: Доложить в цикл Issue
        # Уходит всегда: цикл ждёт в фазе `pr-open`, и молчание провалившегося
        # ревью оставило бы задачу там навсегда. Нечем доложить — тоже факт.
        if: always() && steps.gate.outputs.go == 'true'
        env:
          ISSUE_AGENT_URL: ${{ secrets.ISSUE_AGENT_URL }}
          AGENT_EVENT_SECRET: ${{ secrets.AGENT_EVENT_SECRET }}
          ROOT_ISSUE: ${{ inputs.root_issue }}
          REVIEW_OUTCOME: ${{ steps.review.outcome }}
        run: |
          set -euo pipefail
          if [ -z "${ISSUE_AGENT_URL:-}" ] || [ -z "${AGENT_EVENT_SECRET:-}" ]; then
            echo "::warning::ISSUE_AGENT_URL/AGENT_EVENT_SECRET не заданы — событие не отправлено"
            exit 0
          fi

          # Ключ задачи: из входа вызова, иначе из тела PR. Несколько `Closes #N`
          # оставляют ключ пустым намеренно — выбрать первый попавшийся значит
          # привязать работу не к той задаче.
          root="$ROOT_ISSUE"
          if [ -z "$root" ]; then
            body=$(gh pr view "$PR_NUMBER" --repo "$GITHUB_REPOSITORY" --json body --jq .body)
            mapfile -t found < <(grep -oiE '\b(close[sd]?|fix(e[sd])?|resolve[sd]?)[: ]+#[0-9]+' <<<"$body" \
                                 | grep -oE '[0-9]+' | sort -u)
            [ "${#found[@]}" -eq 1 ] && root="${found[0]}"
          fi

          if [ "$REVIEW_OUTCOME" = "success" ]; then
            status=started
            detail="PR-Agent опубликовал ревью на PR #${PR_NUMBER}"
          else
            status=failed
            detail="Ревью не выполнено: ${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}"
          fi

          # Ревизия, по которой шло ревью, входит в ключ идемпотентности цикла.
          # Без неё каждый круг правок докладывал одну и ту же тройку
          # `(ref, phase, status)`, второй доклад отбрасывался как повторная
          # доставка — и круг правок физически не мог пройти дважды.
          revision=$(gh pr view "$PR_NUMBER" --repo "$GITHUB_REPOSITORY" \
                       --json headRefOid --jq .headRefOid)

          payload=$(jq -nc --arg repo "$GITHUB_REPOSITORY" --arg status "$status" \
            --arg ref "$PR_NUMBER" --arg detail "$detail" --arg root "$root" \
            --arg revision "$revision" \
            '{repo:$repo, agent:"pr-agent", phase:"pr-review", status:$status,
              ref:$ref, detail:$detail, revision:$revision}
             + (if $root == "" then {} else {root_issue: ($root|tonumber)} end)')

          sig="sha256=$(printf '%s' "$payload" \
            | openssl dgst -sha256 -hmac "$AGENT_EVENT_SECRET" -r | cut -d' ' -f1)"

          curl -sS --fail-with-body -X POST "${ISSUE_AGENT_URL%/}/agent-event" \
            -H 'Content-Type: application/json' \
            -H "X-Agent-Signature-256: $sig" \
            -d "$payload"
</file>

